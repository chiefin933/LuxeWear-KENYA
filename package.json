{
  "name": "luxewear-kenya",
  "version": "1.0.0",
  "description": "LuxeWear Kenya — E-Commerce Engine & Automation Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npx tsx watch src/server.ts",
    "build": "npx tsc",
    "start": "node dist/server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:format": "npx prisma format",
    "prisma:validate": "npx prisma validate",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev --name init",
    "prisma:seed": "npx tsx prisma/seed.ts",
    "test:db": "npx tsx tests/db-invariants.test.ts",
    "test:foundation": "npx tsx tests/backend-foundation.test.ts",
    "test:auth": "npx tsx tests/auth-rbac.test.ts",
    "test:catalog": "npx tsx tests/catalog-api.test.ts",
    "test:checkout": "npx tsx tests/cart-checkout-api.test.ts",
    "test:payment": "npx tsx tests/mpesa-payment-api.test.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "keywords": [
    "ecommerce",
    "kenya",
    "mpesa",
    "prisma",
    "postgresql",
    "n8n"
  ],
  "author": "LuxeWear Engineering",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
